{
  "name": "avalonlogs",
  "version": "1.0.0",
  "description": "https://avalongame.online/ is a site that allows friends to play Avalon: The Resistance in person or via videoconference.",
  "main": "fetch-new-logs.js",
  "scripts": {
    "lint": "vp lint . --fix",
    "format": "prettier --write .",
    "oxlint:ci": "vp lint . --format json",
    "prettier:ci": "prettier --check \"src/**/*.{js,ts,css,md,json}\"",
    "typecheck:ci": "tsc --noEmit",
    "test": "vp test run --passWithNoTests",
    "test:ci": "vp test run --passWithNoTests",
    "prepare": "VITE_GIT_HOOKS=0 vp config"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motlin/avalonlogs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/motlin/avalonlogs/issues"
  },
  "homepage": "https://github.com/motlin/avalonlogs#readme",
  "dependencies": {
    "firebase-admin": "^13.4.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite-plus": "0.2.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "packageManager": "npm@12.0.2"
}
